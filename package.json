{
  "name": "apexos-config-helper",
  "displayName": "ApexOS Config Helper",
  "description": "Completion for entity-id's in ApexOS Configurations",
  "version": "2.2.1",
  "preview": false,
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "publisher": "apexos",
  "repository": {
    "type": "git",
    "url": "https://github.com/apexinfosysindia/config-helper"
  },
  "bugs": {
    "url": "https://github.com/apexinfosysindia/config-helper/issues"
  },
  "license": "MIT",
  "icon": "assets/logo.png",
  "activationEvents": [
    "workspaceContains:**/configuration.yaml",
    "workspaceContains:**/ui-lovelace.yaml",
    "onLanguage:apexos",
    "onFileSystem:ftp",
    "onFileSystem:ssh",
    "onFileSystem:sftp"
  ],
  "keywords": [
    "apexos",
    "yaml",
    "configuration",
    "automation"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": [
      {
        "title": "ApexOS Config Helper",
        "properties": {
          "apexos.ignoreCertificates": {
            "type": "boolean",
            "description": "Enable insecure transport. Check this if you want to connect over an insecure HTTPS transport with a invalid certificate!"
          },
          "apexos.disableAutomaticFileAssociation": {
            "type": "boolean",
            "default": false,
            "description": "Disable automatic association of YAML files with the ApexOS language. When enabled, the extension will not automatically set file associations for YAML files, even in detected ApexOS workspaces."
          },
          "apexos.autoRenderTemplates": {
            "type": "boolean",
            "default": true,
            "description": "Enable automatic rendering of ApexOS templates on hover. When enabled, templates will be rendered and displayed as previews when hovering over template values in YAML files."
          }
        }
      }
    ],
    "submenus": [
      {
        "id": "apexos.reload",
        "label": "ApexOS: Reload specific integration"
      }
    ],
    "snippets": [
      {
        "language": "apexos",
        "path": "./out/snippets/apexos_automation.json"
      },
      {
        "language": "apexos",
        "path": "./out/snippets/apexos_script.json"
      }
    ],
    "languages": [
      {
        "id": "apexos",
        "configuration": "./syntaxes/yaml-language-configuration.json",
        "extensions": [
          ".yml",
          ".yaml"
        ],
        "aliases": [
          "ApexOS",
          "apexos",
          "apexos"
        ]
      },
      {
        "comments": "unfortunately this dummy entry is necessary for embedding to work",
        "id": "apexos-jinja",
        "configuration": "./jinja-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "comments": [
          "YAML syntax as base for ApexOS",
          "scopeName changed so that we can use it as base for injections"
        ],
        "language": "apexos",
        "scopeName": "source.apexos",
        "path": "./syntaxes/external/YAML.tmLanguage"
      },
      {
        "comments": [
          "Jinja syntax as injection into ApexOS YAML",
          "This is so that we do not need to rely on the Jinja extension being installed"
        ],
        "language": "apexos-jinja",
        "scopeName": "source.apexos-jinja",
        "path": "./syntaxes/external/jinja.tmLanguage.json"
      },
      {
        "comments": [
          "Highlighting of ApexOS keywords in Jinja"
        ],
        "path": "./syntaxes/apexos/jinja-keywords.tmLanguage",
        "scopeName": "injection.apexos.jinja-keywords",
        "injectTo": [
          "source.apexos"
        ]
      },
      {
        "comments": [
          "Additional Jinja grammars"
        ],
        "path": "./syntaxes/apexos/jinja-extras.tmLanguage",
        "scopeName": "injection.apexos.jinja-extras",
        "injectTo": [
          "source.apexos"
        ]
      },
      {
        "comments": [
          "Support for Jinja in double curly braces"
        ],
        "path": "./syntaxes/apexos/jinja-braces.tmLanguage",
        "scopeName": "injection.apexos.jinja-braces",
        "embeddedLanguages": {
          "meta.embedded.inline.jinja": "apexos-jinja"
        },
        "injectTo": [
          "source.apexos"
        ]
      },
      {
        "comments": [
          "Support for Jinja in single curly braces with percentage symbol"
        ],
        "path": "./syntaxes/apexos/jinja-braces-block.tmLanguage",
        "scopeName": "injection.apexos.jinja-braces-block",
        "embeddedLanguages": {
          "meta.embedded.block.jinja": "apexos-jinja"
        },
        "injectTo": [
          "source.apexos"
        ]
      },
      {
        "comments": [
          "Support for Jinja in conditionals"
        ],
        "path": "./syntaxes/apexos/jinja-conditionals.tmLanguage",
        "scopeName": "injection.apexos.jinja-conditionals",
        "embeddedLanguages": {
          "meta.embedded.inline.jinja": "apexos-jinja",
          "meta.embedded.block.jinja": "apexos-jinja"
        },
        "injectTo": [
          "source.apexos"
        ]
      },
      {
        "comments": [
          "The quote escapes implemented in the conditionals injection do not work inside brackets etc.",
          "Support for single quote escapes in Jinja"
        ],
        "path": "./syntaxes/apexos/jinja-single-quote-escape.tmLanguage",
        "scopeName": "injection.apexos.jinja-single-quote-escape",
        "injectTo": [
          "source.apexos"
        ]
      },
      {
        "comments": [
          "The quote escapes implemented in the conditionals injection do not work inside brackets etc.",
          "Support for double quote escapes in Jinja"
        ],
        "path": "./syntaxes/apexos/jinja-double-quote-escape.tmLanguage",
        "scopeName": "injection.apexos.jinja-double-quote-escape",
        "injectTo": [
          "source.apexos"
        ]
      }
    ],
